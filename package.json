{
  "name": "block-model-renderer",
  "version": "2.15.1",
  "description": "Minecraft block and item model rendering for Node.js and the browser",
  "author": "Ewan Howell <ewanhowell5195>",
  "license": "MPL-2.0",
  "type": "module",
  "main": "./index.js",
  "types": "./types/node.d.ts",
  "jsdelivr": "./dist/block-model-renderer.min.js",
  "exports": {
    ".": {
      "node": {
        "types": "./types/node.d.ts",
        "default": "./src/node.js"
      },
      "default": {
        "types": "./types/web.d.ts",
        "default": "./dist/block-model-renderer.min.js"
      }
    }
  },
  "files": [
    "index.js",
    "src/",
    "dist/",
    "types/",
    "!types/tsconfig.json",
    "assets/",
    "assets.zip",
    "docs/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ewanhowell5195/block-model-renderer.git"
  },
  "bugs": {
    "url": "https://github.com/ewanhowell5195/block-model-renderer/issues"
  },
  "keywords": [
    "minecraft",
    "render",
    "block",
    "item",
    "model",
    "resource-pack"
  ],
  "scripts": {
    "prepublishOnly": "node tools/build-assets.js && node tools/build.js",
    "build": "node tools/build.js",
    "build:assets": "node tools/build-assets.js",
    "generate": "node tools/generate/generate.js",
    "types": "tsc -p types/tsconfig.json",
    "test": "node tools/generate/test.js",
    "example": "node examples/node/example.js",
    "all": "node examples/node/render_all.js",
    "animated": "node examples/node/render_animated.js",
    "banners": "node examples/node/render_banners.js",
    "fixed": "node examples/node/render_fixed.js",
    "overrides": "node examples/node/render_overrides.js",
    "scene": "node examples/node/render_scene.js",
    "simple": "node examples/node/render_simple.js",
    "textures": "node examples/node/render_textures.js",
    "full": "npm run example && npm run all && npm run animated && npm run banners && npm run fixed && npm run overrides && npm run scene && npm run simple && npm run textures && npm run loader",
    "loader": "node examples/node/render_loader.js"
  },
  "dependencies": {
    "gl": "^8.1.6",
    "headless-three": "^1.8.1",
    "sharp": "^0.34.5",
    "skia-canvas": "^3.0.8"
  },
  "peerDependencies": {
    "three": ">=0.152.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/three": "^0.162.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  }
}
